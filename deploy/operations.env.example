# Copy to /opt/cutmy/shared/operations.env with mode 0600. Never commit secrets.
# Values are literal; shell expansion and executable expressions are not used.
CUTMY_BACKUP_RETENTION_DAYS=7
CUTMY_BACKUP_MAX_COPIES=168
CUTMY_BACKUP_MAX_BYTES=4294967296
CUTMY_BACKUP_TIMEOUT=600
CUTMY_BACKUP_MAX_SQL_BYTES=2147483648
CUTMY_BACKUP_VERIFY_TIMEOUT=60
# Keep current + exact previously active release; extra versions are optional.
CUTMY_RELEASES_KEEP=2
CUTMY_CLEANUP_GRACE_HOURS=24
# Docker buildx supports this limit; live images and in-use cache are preserved.
CUTMY_BUILD_CACHE_MAX_BYTES=536870912
CUTMY_ALERT_MIN_FREE_BYTES=10737418240
CUTMY_ALERT_DISK_PERCENT=85
CUTMY_ALERT_QUEUE_SECONDS=600
CUTMY_ALERT_BACKUP_SECONDS=7200
# Optional remote destination. Pre-create its directory and pin its host key.
# Receiver retention is configured independently by the backup account operator.
# CUTMY_BACKUP_REMOTE_TARGET=backup@backup.example.com
# CUTMY_BACKUP_REMOTE_DIR=/srv/backups/cutmy
# CUTMY_BACKUP_SSH_KEY=/opt/cutmy/shared/backup_ed25519
# Optional operator adapter, absolute executable accepting one JSON event stdin.
# CUTMY_ALERT_HOOK=/opt/cutmy/shared/notify-operator
