[Unit]
Description=Cutmy media process outgoing network restrictions
Requires=docker.service
After=docker.service
Before=cutmy-stack.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock --exclusive --wait 300 /opt/cutmy/shared/deployment.lock /bin/bash /opt/cutmy/current/web/deploy/egress.sh apply
RemainAfterExit=yes
TimeoutStartSec=360

[Install]
WantedBy=docker.service
