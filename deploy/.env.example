# Copy to an operator-only path. Never commit the populated file.
DOMAIN=cutmy.video
POSTGRES_PASSWORD=replace-with-a-long-random-value
RELEASE_TAG=local
# Global media budget; leave room for images, the database, logs and backups.
MAX_STORAGE_BYTES=10737418240
# The core and web checkouts are sibling directories by default.
CORE_CONTEXT=../../core
