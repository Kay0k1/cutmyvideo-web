# Copy to an operator-only path. Never commit the populated file.
DOMAIN=cutmy.video
POSTGRES_PASSWORD=replace-with-a-long-random-value
RELEASE_TAG=local
# Global media budget; leave room for images, the database, logs and backups.
MAX_STORAGE_BYTES=10737418240
MAX_SOURCE_BYTES=1073741824
MAX_FETCH_BYTES=1073741824
SOURCE_TIMEOUT=2m
UPLOAD_TIMEOUT=2h
MAX_UPLOAD_BODY_BYTES=1075838976
MAX_OUTPUT_BYTES=1073741824
MAX_OWNER_BYTES=2147483648
STORAGE_SAFETY_BYTES=536870912
STORAGE_WAIT_TIMEOUT=30m
SOURCE_TTL=24h
ARTIFACT_TTL=24h
WORKER_CONCURRENCY=1
FFMPEG_THREADS=2
FFMPEG_PROFILE=fast
# The core and web checkouts are sibling directories by default.
CORE_CONTEXT=../../core
