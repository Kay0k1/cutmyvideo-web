{
  "name": "cutmyvideo-web",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:deploy": "python3 -m unittest discover -s deploy -p '*_test.py'",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:responsive": "playwright test --config=e2e/responsive.config.ts",
    "test:e2e-contract-types": "tsc -p tsconfig.e2e-contract.json",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "@radix-ui/react-select": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "description": "Product browser editor for cutting video and audio with the open-source cutmyvideo-core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kay0k1/cutmyvideo-web.git"
  },
  "bugs": {
    "url": "https://github.com/Kay0k1/cutmyvideo-web/issues"
  },
  "homepage": "https://cutmy.video"
}
